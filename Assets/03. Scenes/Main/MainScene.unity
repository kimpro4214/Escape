  m_Script: {fileID: 11500000, guid: fb41182c213a1454aa20dc86e7c91a65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VoiceAIManager
  whisperSTT: {fileID: 785261725}
  gptService: {fileID: 1606908357}
  supertoneTTS: {fileID: 1345290434}
  openAITTS: {fileID: 753553069}
  ttsType: 1
  scenarios:
  - title: "\uC0AC\uB9C9\uC758 \uB208\uBB3C"
    openingText: "\uD14C\uC2A4\uD2B8 \uC785\uB2C8\uB2E4."
    correctAnswer: "\uBB3C\uBCD1"
    secretTruth: "\uADF8 \uBB3C\uBCD1\uC740 \uC0AC\uC2E4 \uD0D0\uD5D8\uAC00 \uBCF8\uC778\uC774
      \uBA70\uCE60 \uC804 \uB2E4 \uB9C8\uC2DC\uACE0 \uBC84\uB838\uB358 \uBE48 \uBCD1\uC774\uC5C8\uC2B5\uB2C8\uB2E4.
      \uADF8\uB294 \uC0AC\uB9C9\uC5D0\uC11C \uAE38\uC744 \uC783\uACE0 \uAC19\uC740
      \uC790\uB9AC\uB97C \uBA70\uCE60\uC9F8 \uBC45\uBC45 \uB3CC\uACE0 \uC788\uB2E4\uB294
      \uC0AC\uC2E4\uC744 \uAE68\uB2EC\uC740 \uAC83\uC785\uB2C8\uB2E4."
    gptInstruction: "\uB108\uB294 \uBC14\uB2E4\uAC70\uBD81 \uC2A4\uD504 \uAC8C\uC784
      \uB9C8\uC2A4\uD130\uC57C. \uC815\uB2F5\uC740 '\uBB3C\uBCD1'\uC774\uC57C. \uD0D0\uD5D8\uAC00\uAC00
      \uC0AC\uB9C9\uC5D0\uC11C \uC790\uAE30\uAC00 \uBC84\uB9B0 \uBE48 \uBCD1\uC744
      \uB2E4\uC2DC \uBC1C\uACAC\uD558\uACE0 \uC808\uB9DD\uD55C \uC0C1\uD669. \uADDC\uCE59:
      1. \uC608/\uC544\uB2C8\uC624/\uAD00\uB828\uC5C6\uC74C\uC73C\uB85C \uC9E7\uAC8C
      \uB2F5\uD574. 2. \uC808\uB300 \uC815\uB2F5\uC744 \uBA3C\uC800 \uB9D0\uD558\uC9C0
      \uB9C8. 3. \uD55C\uAD6D\uC5B4\uB85C \uB2F5\uBCC0\uD574."
    hints:
    - "\uD0D0\uD5D8\uAC00\uC5D0\uAC8C \uAF2D \uD544\uC694\uD55C \uBB3C\uAC74\uC774\uC9C0\uB9CC,
      \uC9C0\uAE08\uC740 \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    - "\uC774\uAC83\uC774 \uAE68\uB057\uD55C \uC774\uC720\uB294 \uD0D0\uD5D8\uAC00
      \uBCF8\uC778\uC758 \uBB3C\uAC74\uC774\uC5C8\uAE30 \uB54C\uBB38\uC785\uB2C8\uB2E4."
    - "\uC774\uAC83\uC758 \uBC1C\uACAC\uC740 \uD0D0\uD5D8\uAC00\uAC00 \uC81C\uC790\uB9AC\uAC78\uC74C\uC744
      \uD558\uACE0 \uC788\uB2E4\uB294 \uC99D\uAC70\uC785\uB2C8\uB2E4."
  chatLogManager: {fileID: 0}
